{
  "_comment": [
    "AOJIT (AOT on JIT code) cases. cmd runs with sh -c in /tmp/aojit/<group>, output discarded;",
    "wall time is measured with AOT on and off (echo on|off > /proc/ish/jit) in the same ish.",
    "needs: 'bin:<cmd>' / 'py:<module>' / 'file:<path>' must hold or the case is skipped.",
    "images: the recorded images (images.json) the case is meant to exercise.",
    "family: true = runs an older build of the modules (from /tmp/aojit/oldlib) against images",
    "recorded from the current ones, i.e. the family-matching path.",
    "holdout: true = the workload is not part of any recording (generalisation check).",
    "tier: quick (a few seconds with AOT off on a Mac) or full.",
    "volatile: true = stdout differs run to run (timestamps, random data), so it is not compared."
  ],
  "cases": [
    {"id": "py.pip_list", "group": "py", "title": "pip list", "tier": "quick", "images": ["musl", "python", "zlib"],
     "cmd": "python3 -m pip list"},
    {"id": "py.startup_json_x10", "group": "py", "title": "python 启动+json x10", "tier": "quick", "images": ["musl", "python"],
     "cmd": "for i in $(seq 1 10); do echo '{\"a\":[1]}' | python3 -c 'import json,sys; print(json.load(sys.stdin))'; done"},
    {"id": "zlib.roundtrip", "group": "zlib", "title": "zlib 压缩/解压", "tier": "quick", "images": ["zlib", "python"],
     "cmd": "python3 -c \"import zlib; t = b'alpha beta gamma delta agent zlib ' * 150000; print(sum(len(zlib.decompress(zlib.compress(t, l))) for l in (1, 6, 9)))\""},
    {"id": "bb.pipeline", "group": "busybox", "title": "busybox 管道", "tier": "quick", "images": ["musl", "busybox"],
     "cmd": "sed 's/1/x/g' n60k.txt | sort | uniq -c | wc -l"},
    {"id": "bb.ash_loop", "group": "busybox", "title": "ash 循环", "tier": "quick", "images": ["musl", "busybox"],
     "cmd": "i=0; while [ $i -lt 60000 ]; do i=$((i+1)); done"},
    {"id": "bb.grep_r", "group": "busybox", "title": "grep -r", "tier": "quick", "images": ["musl", "busybox"],
